# GitHub Actions Secrets Required for Pulumi GCP virtual machine
# Add these in GitHub Repository Settings > Secrets and variables > Actions

# Pulumi Configuration
PULUMI_ACCESS_TOKEN=pul-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PULUMI_CONFIG_PASSPHRASE=your-secure-passphrase-for-encryption

# GCP Authentication (Service Account JSON key)
GOOGLE_CREDENTIALS={"type": "service_account", "project_id": "your-project", "private_key_id": "...", "private_key": "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n", "client_email": "...", "client_id": "...", "auth_uri": "https://accounts.google.com/o/oauth2/auth", "token_uri": "https://oauth2.googleapis.com/token"}

# Optional: Default GCP Project (can be overridden per workflow run)
GCP_PROJECT=your-gcp-project-id
